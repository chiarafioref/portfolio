# Funzione api/contact.ts: impostare i valori su Vercel (Settings → Environment Variables), mai nel codice.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Facoltative: togliere il "#" solo se servono.
# Mittente (senza, si usa onboarding@resend.dev, valido solo per i test).
# CONTACT_FROM_EMAIL=
# Altre origini autorizzate, separate da virgola (es. https://www.miodominio.it).
# ALLOWED_ORIGINS=
# Endpoint del form, se diverso da /api/contact.
# VITE_CONTACT_ENDPOINT=
# "true" simula l'invio del form senza chiamare l'API (utile in anteprima).
# VITE_CONTACT_DEMO=
